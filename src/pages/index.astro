---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Grid from "../components/Grid.astro";
import SeriesCard from "../components/SeriesCard.astro";
import { getAllSeries } from "../utils/content.ts";

const series = await getAllSeries();
---

<BaseLayout title="Inicio" description="Periodismo investigativo y filtraciones en Quintana Roo y México.">
  <Hero 
    title="Defender la soberanía y bienestar de México y Quintana Roo"
    subtitle="Periodismo de investigación independiente, transparencia y denuncia. Reportajes, series y filtraciones sobre crimen, corrupción y poder."
  />

  <section>
    <h2 class="section-title">Series recientes</h2>
    <Grid>
      {series.slice(0, 3).map(s => <SeriesCard {...s} link={`/series/${s.slug}/`} />)}
    </Grid>
  </section>

  <section class="cta-section">
    <a href="/contacto-seguro" class="button">Filtra información o denuncia aquí</a>
  </section>

  <section class="cta-section">
    <a href="/carnet" class="button secondary">Colabora con nosotros</a>
  </section>

  <section class="about">
    <p>
      <strong>Caballo Azteca es una red de periodistas e investigadores independientes.</strong>  
      Investigamos lo que el gobierno no ha querido o no ha podido investigar y hacemos público lo que los grandes medios callaron.  
      Nos mantenemos exclusivamente de <strong>donaciones</strong> para conservar nuestra independencia.
    </p>
    <a href="/donar" class="button">Apóyanos con una donación</a>
  </section>

  <style>
    /* Título de secciones */
    .section-title {
      font-size: 1.4rem;
      font-weight: 600;
      text-align: center;
      margin: 2rem 0 1.5rem 0;
    }

    /* Secciones de CTA (botones centrados) */
    .cta-section {
      margin-top: 2.5em;
      text-align: center;
    }

    /* Sección about */
    .about {
      margin: 2.5em auto;
      text-align: center;
      max-width: 700px;
      padding: 0 1rem;
      line-height: 1.6;
    }

    .about p {
      font-size: 1rem;
      margin-bottom: 1.5rem;
    }

    /* Botones */
    .button {
      display: inline-block;
      font-size: 1.1em;
      padding: 0.8em 2em;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 600;
      background: #0070f3;
      color: #fff;
      transition: background 0.3s ease;
    }

    .button:hover {
      background: #005fc1;
    }

    .button.secondary {
      background: #222;
    }

    .button.secondary:hover {
      background: #444;
    }

    /* Responsive */
    @media (max-width: 600px) {
      .section-title {
        font-size: 1.2rem;
      }

      .button {
        display: block;
        width: 90%;
        margin: 0 auto;
      }

      .about p {
        font-size: 0.95rem;
      }
    }
  </style>
</BaseLayout>
