---
import BaseLayout from "../../../layouts/BaseLayout.astro";

// 🔹 Definir la lista dentro del mismo bloque
export const carnetsValidos = [
  {
    hash: "CA-9X7Q-13AM-77SD-42",
    nombre: "Miembro Anónimo",
    emitido: "Julio 2025",
    vigencia: "1 año",
    estado: "valido"
  },
  {
    hash: "CA-8K4T-11XX-66LL-99ZZ",
    nombre: "Colaborador Especial",
    emitido: "Junio 2025",
    vigencia: "1 año",
    estado: "valido"
  }
];

// 🔹 Generar rutas estáticas en el build
export function getStaticPaths() {
  return carnetsValidos.map((c) => ({
    params: { hash: c.hash },
  }));
}

// 🔹 Obtener hash de la URL
const { hash } = Astro.params;

// 🔹 Buscar el carnet
const carnet = carnetsValidos.find((c) => c.hash === hash);
---

<BaseLayout title="Verificación de Carnet | Caballo Azteca">
  <section class="max-w-3xl mx-auto text-center py-12 px-4">
    <h1 class="text-3xl font-bold mb-2">Verificación de Carnet</h1>
    <p class="text-gray-600">Código: <strong>{hash}</strong></p>

    {carnet ? (
      <div class="bg-white shadow-lg rounded-xl p-6">
        <p class="text-green-600 font-bold text-lg">✔ Carnet válido y vigente</p>
        <p class="mt-2 text-gray-700">
          Perteneciente a <strong>{carnet.nombre}</strong>.
        </p>
        <p class="text-gray-500 text-sm">
          Emitido: <strong>{carnet.emitido}</strong> – Vigencia: <strong>{carnet.vigencia}</strong>
        </p>
      </div>
    ) : (
      <div class="bg-white shadow-lg rounded-xl p-6">
        <p class="text-red-600 font-bold text-lg">✘ Carnet no existe en el sistema</p>
      </div>
    )}
  </section>
</BaseLayout>
