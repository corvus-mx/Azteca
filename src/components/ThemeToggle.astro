<script type="module" is:inline>
  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    // Aplicar el tema y (si viene de un toggle) guardarlo
    function applyTheme(theme, save = false) {
      document.documentElement.setAttribute('data-theme', theme);
      if (save) {
        localStorage.setItem('theme', theme);
      }
      btn.setAttribute(
        'aria-label',
        theme === 'dark' ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro'
      );
    }

    // Obtener siempre el tema del sistema
    function getSystemTheme() {
      return window.matchMedia('(prefers-color-scheme: dark)').matches
        ? 'dark'
        : 'light';
    }

    // 1) Al iniciar siempre usar el sistema
    applyTheme(getSystemTheme());

    // 2) Si el usuario hace click, alternamos y guardamos
    btn.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      applyTheme(next, true);
    });

    // 3) Si cambia la preferencia del sistema y no hay override reciente, actualizar
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      // Solo reaplicar si el usuario no ha guardado manualmente
      if (!localStorage.getItem('theme')) {
        applyTheme(e.matches ? 'dark' : 'light');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThemeToggle);
  } else {
    initThemeToggle();
  }
</script>
